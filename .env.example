# Copy to .env and fill in per deploy. Unset links fall back to the
# page's "Get the app" section instead of a dead link.
PUBLIC_SITE_URL=https://example.com
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=
# Digits only, with country code, e.g. 9715XXXXXXXX
PUBLIC_WHATSAPP_NUMBER=
# Receives POST {"contact": "...", "lang": "en"|"ar"} as JSON; 2xx = joined.
PUBLIC_WAITLIST_ENDPOINT=
