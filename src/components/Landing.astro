---
import '../styles/global.css';
import Glyph from './Glyph.astro';
import type { GlyphName } from './Glyph.astro';
import Mark from './Mark.astro';
import Phone from './Phone.astro';
import type { Screen } from './Phone.astro';
import type { Dict } from '../i18n/en';
import { links, site, waitlistEndpoint } from '../config';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const isAr = t.lang === 'ar';
const canonical = new URL(isAr ? '/ar/' : '/', site).href;
const alternate = new URL(isAr ? '/' : '/ar/', site).href;

const stepScreens: Screen[] = ['shop', 'schedule', 'track', 'done'];
const stepGlyphs: GlyphName[] = ['clothes', 'collect', 'treat', 'deliver'];
const stageGlyphs: GlyphName[] = ['collect', 'custody', 'inspect', 'treat', 'deliver'];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={t.lang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={t.lang} href={canonical} />
    <link rel="alternate" hreflang={t.nav.switchLang} href={alternate} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fbfbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0f11" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={new URL('/images/hero-linen.webp', site).href} />
    <meta property="og:locale" content={isAr ? 'ar_AE' : 'en_AE'} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" as="image" href="/images/hero-linen.webp" fetchpriority="high" />
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>

    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href={isAr ? '/ar/' : '/'} aria-label={t.brand}>
          <Mark size={30} />
          <span class="brand-word">{t.brand}</span>
        </a>
        <nav class="nav-links" aria-label={t.brand}>
          <a href="#how">{t.nav.how}</a>
          <a href="#ways">{t.nav.ways}</a>
          <a href="#clean">{t.nav.clean}</a>
          <a href="#faq">{t.nav.faq}</a>
        </nav>
        <div class="nav-end">
          <a class="lang" href={t.nav.switchHref} hreflang={t.nav.switchLang} lang={t.nav.switchLang}>{t.nav.switchLabel}</a>
          <a class="btn btn-ink btn-sm" href="#get-app">{t.nav.getApp}</a>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- First viewport: linen field, tape headline, the live Home screen -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-photo">
          <img
            src="/images/hero-linen.webp"
            alt={t.hero.photoAlt}
            width="1400"
            height="928"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="hero-tape tape-band">
          <h1 id="hero-title" class="display">{t.hero.title}</h1>
          <p class="fibre hero-fibre">{t.tagline}</p>
          <p class="hero-lead">{t.hero.lead}</p>
          <div class="cta-row">
            <a class="store" href={links.appStore} data-store="ios">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v11M7.5 9.5 12 14l4.5-4.5M4 15.5V20h16v-4.5" /></svg>
              <span><small>{t.store.apple.small}</small><b>{t.store.apple.big}</b></span>
            </a>
            <a class="store" href={links.playStore} data-store="android">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v11M7.5 9.5 12 14l4.5-4.5M4 15.5V20h16v-4.5" /></svg>
              <span><small>{t.store.google.small}</small><b>{t.store.google.big}</b></span>
            </a>
            <a class="btn btn-rule whatsapp" href={links.whatsapp} rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.6 18.6z" /><path d="M9.2 9.1c.3 2.6 2.4 4.9 5.6 5.7l1.1-1.4-1.9-1-1 .8a4.6 4.6 0 0 1-2.2-2.2l.8-1-1-1.9z" /></svg>
              {t.hero.whatsapp}
            </a>
          </div>
        </div>
        <figure class="hero-phone">
          <Phone t={t} screens={['home']} />
          <figcaption class="fibre">{t.hero.sample}</figcaption>
        </figure>
      </section>

      <!-- Signature: the pinned phone runs the order as the story scrolls -->
      <section class="demo" id="how" aria-labelledby="demo-title">
        <h2 id="demo-title" class="section-title demo-title">{t.demo.title}</h2>
        <div class="demo-grid">
          <ol class="steps">
            {
              t.demo.steps.map((step, i) => (
                <li
                  class:list={['step', { 'step-track': stepScreens[i] === 'track' }]}
                  data-screen={stepScreens[i]}
                  data-track-scope={stepScreens[i] === 'track' ? '' : undefined}
                >
                  <div class="step-text">
                    <span class="step-glyph">
                      <Glyph name={stepGlyphs[i]} size={30} filled={i === 2} />
                    </span>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                    {stepScreens[i] === 'track' && (
                      <ol class="stage-list" aria-label={step.title}>
                        {t.stages.map((name, s) => (
                          <li data-stage-row={s} data-state={s < 3 ? 'done' : s === 3 ? 'active' : 'upcoming'}>
                            <span class="stage-list-glyph">
                              <Glyph name={stageGlyphs[s]} size="100%" stateful />
                            </span>
                            <span>{name}</span>
                          </li>
                        ))}
                      </ol>
                    )}
                  </div>
                  <div class="step-phone">
                    <Phone t={t} screens={[stepScreens[i]]} />
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="demo-stage" aria-hidden="true">
            <Phone t={t} screens={stepScreens} id="demo-phone" />
            <p class="fibre demo-note">{t.hero.sample}</p>
          </div>
        </div>
      </section>

      <!-- Two honest ways to order -->
      <section class="ways" id="ways" aria-labelledby="ways-title">
        <div class="section-head">
          <h2 id="ways-title" class="section-title">{t.ways.title}</h2>
          <p class="section-lead">{t.ways.lead}</p>
        </div>
        <div class="ways-labels">
          <article class="way">
            <header class="way-head">
              <Glyph name="clothes" size={34} />
              <div>
                <h3>{t.ways.shop.name}</h3>
                <p class="stamp">{t.ways.shop.promise}</p>
              </div>
            </header>
            <p class="way-body">{t.ways.shop.body}</p>
            <div class="ticket">
              <p class="woven-tag"><b>{t.ways.shop.ticket}</b></p>
              <table>
                <tbody>
                  {
                    t.ways.shop.lines.map(([name, qty, amount]) => (
                      <tr>
                        <th scope="row">
                          {name} <span class="qty-x">× {qty}</span>
                        </th>
                        <td>{amount}</td>
                      </tr>
                    ))
                  }
                  <tr class="sub">
                    <th scope="row">{t.ways.shop.subtotal}</th>
                    <td>43.00</td>
                  </tr>
                  <tr>
                    <th scope="row">{t.ways.shop.vip} <span class="qty-x">15%</span></th>
                    <td>6.45</td>
                  </tr>
                  <tr>
                    <th scope="row">{t.ways.shop.cod}</th>
                    <td>5.00</td>
                  </tr>
                </tbody>
              </table>
              <p class="ticket-total">
                <span class="stamp">{t.ways.shop.total}</span>
                <span class="serial-amount"><small>AED</small> 54.45</span>
              </p>
              <p class="fibre">{t.ways.shop.sampleNote}</p>
            </div>
          </article>

          <article class="way">
            <header class="way-head">
              <Glyph name="inspect" size={34} />
              <div>
                <h3>{t.ways.quick.name}</h3>
                <p class="stamp">{t.ways.quick.promise}</p>
              </div>
            </header>
            <p class="way-body">{t.ways.quick.body}</p>
            <ol class="wizard">
              {t.ways.quick.steps.map((s) => <li>{s}</li>)}
            </ol>
            <div class="reserved">
              <span class="stamp">{t.ways.quick.amount}</span>
              <span class="reserved-slot">{t.ways.quick.amountWaiting}</span>
            </div>
            <p class="report">
              <Glyph name="inspect" size={22} />
              <span>{t.ways.quick.report}</span>
            </p>
          </article>
        </div>
      </section>

      <!-- What we clean: pieces hung from one stitched rail -->
      <section class="clean" id="clean" aria-labelledby="clean-title">
        <div class="section-head">
          <h2 id="clean-title" class="section-title">{t.clean.title}</h2>
          <p class="section-lead">{t.clean.lead}</p>
        </div>
        <ul class="rail">
          {
            t.clean.items.map((item, i) => (
              <li class:list={['piece', `piece-${i}`]}>
                <span class="thread" aria-hidden="true" />
                <div class="piece-photo">
                  <img src={item.img} alt={item.alt} loading="lazy" decoding="async" />
                </div>
                <div class="sewn">
                  <Glyph name={item.glyph as GlyphName} size={26} />
                  <span>
                    <b>{item.name}</b>
                    <small>{item.services}</small>
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Service level and payment -->
      <section class="levels" aria-labelledby="levels-title">
        <h2 id="levels-title" class="section-title">{t.levels.title}</h2>
        <div class="levels-band">
          <div class="level">
            <div class="level-head">
              <Glyph name="treat" size={30} dots={1} />
              <h3>{t.levels.standard.name}</h3>
            </div>
            <ul>
              {t.levels.standard.points.map((x) => <li>{x}</li>)}
            </ul>
          </div>
          <div class="level level-vip">
            <div class="level-head">
              <Glyph name="treat" size={30} dots={2} />
              <h3><span class="woven-label"><b>{t.levels.vip.name}</b></span></h3>
            </div>
            <span class="twin" aria-hidden="true"></span>
            <ul>
              {t.levels.vip.points.map((x) => <li>{x}</li>)}
            </ul>
          </div>
          <div class="level level-pay">
            <h3 class="stamp">{t.levels.payTitle}</h3>
            <dl>
              {
                t.levels.pay.map(([name, note]) => (
                  <div>
                    <dt>{name}</dt>
                    <dd>{note}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </section>

      <!-- Questions -->
      <section class="faq" id="faq" aria-labelledby="faq-title">
        <h2 id="faq-title" class="section-title">{t.faq.title}</h2>
        <div class="faq-list">
          {
            t.faq.items.map((item) => (
              <details>
                <summary>
                  <span>{item.q}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                </summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <!-- Close: the woven label's ink field -->
      <section class="close" id="get-app" aria-labelledby="close-title">
        <div class="close-inner">
          <div class="close-main">
            <Mark size={92} class="close-mark" />
            <h2 id="close-title" class="display close-title">{t.close.title}</h2>
            <p class="close-lead">{t.close.lead}</p>
            <div class="cta-row">
              <a class="store store-light" href={links.appStore}>
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v11M7.5 9.5 12 14l4.5-4.5M4 15.5V20h16v-4.5" /></svg>
                <span><small>{t.store.apple.small}</small><b>{t.store.apple.big}</b></span>
              </a>
              <a class="store store-light" href={links.playStore}>
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v11M7.5 9.5 12 14l4.5-4.5M4 15.5V20h16v-4.5" /></svg>
                <span><small>{t.store.google.small}</small><b>{t.store.google.big}</b></span>
              </a>
            </div>
          </div>
          <form
            class="waitlist"
            data-endpoint={waitlistEndpoint}
            data-lang={t.lang}
            data-msg-sending={t.close.listSending}
            data-msg-done={t.close.listDone}
            data-msg-invalid={t.close.listInvalid}
            data-msg-failed={t.close.listFailed}
            novalidate
          >
            <h3>{t.close.listTitle}</h3>
            <label for="contact">{t.close.listLabel}</label>
            <div class="waitlist-row">
              <input
                id="contact"
                name="contact"
                type="text"
                inputmode="email"
                autocomplete="email"
                dir="ltr"
                placeholder={t.close.listPlaceholder}
                aria-describedby="waitlist-msg"
                required
              />
              <button class="btn btn-join" type="submit">{t.close.listSubmit}</button>
            </div>
            <p id="waitlist-msg" class="waitlist-msg" role="status" aria-live="polite"></p>
            <a class="btn btn-rule-light whatsapp" href={links.whatsapp} rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.6 18.6z" /><path d="M9.2 9.1c.3 2.6 2.4 4.9 5.6 5.7l1.1-1.4-1.9-1-1 .8a4.6 4.6 0 0 1-2.2-2.2l.8-1-1-1.9z" /></svg>
              {t.hero.whatsapp}
            </a>
          </form>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="foot-inner">
        <span class="brand">
          <Mark size={24} />
          <span class="brand-word">{t.brand}</span>
        </span>
        <p class="fibre">{t.tagline}</p>
        <nav aria-label={t.footer.language} class="foot-lang">
          <a href="/" hreflang="en" lang="en" aria-current={isAr ? undefined : 'page'}>English</a>
          <a href="/ar/" hreflang="ar" lang="ar" aria-current={isAr ? 'page' : undefined}>عربي</a>
        </nav>
        <p class="foot-rights">© {year} {t.footer.rights}</p>
      </div>
    </footer>

    <script>
      import '../scripts/page';
    </script>
  </body>
</html>

<style is:global>
  /* ---------- shared atoms ---------- */
  .skip {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-start: -4rem;
    z-index: 50;
    padding: 0.6rem 1rem;
    background: var(--ink);
    color: var(--on-ink);
    border-radius: 8px;
  }
  .skip:focus {
    inset-block-start: 1rem;
  }

  .display {
    font-family: var(--font-label);
    font-stretch: 112%;
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.98;
    font-size: clamp(2.6rem, 1.2rem + 3.7vw, 5rem);
  }
  :root[lang='ar'] .display {
    font-weight: 700;
    line-height: 1.3;
    font-size: clamp(2.2rem, 1.1rem + 3.6vw, 4.6rem);
  }

  .section-title {
    font-family: var(--font-label);
    font-stretch: 108%;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.02;
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.6rem);
    max-inline-size: 18ch;
  }
  :root[lang='ar'] .section-title {
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.35;
    font-size: clamp(1.8rem, 1.1rem + 2.2vw, 3rem);
  }
  .section-lead {
    color: var(--ink-2);
    font-size: 1.125rem;
    max-inline-size: 42ch;
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 3rem;
  }

  .stamp {
    font-family: var(--font-label);
    font-stretch: 84%;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-stamp);
    font-size: 0.8125rem;
    line-height: 1.25;
  }
  .fibre {
    font-family: var(--font-label);
    font-stretch: 84%;
    font-weight: 600;
    letter-spacing: var(--track-fibre);
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--ink-3);
  }
  :root[lang='ar'] .stamp,
  :root[lang='ar'] .fibre {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-block-size: 3.25rem;
    padding: 0.75rem 1.25rem;
    border: 0;
    border-radius: var(--radius-control);
    font-family: var(--font-label);
    font-stretch: 84%;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-stamp);
    font-size: 0.875rem;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 140ms var(--ease-out),
      box-shadow 140ms var(--ease-out),
      scale 140ms var(--ease-out);
  }
  .btn:active {
    scale: 0.985;
  }
  .btn svg {
    inline-size: 1.25rem;
    flex: none;
  }
  .btn-sm {
    min-block-size: 2.75rem;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
  }
  .btn-ink {
    background: var(--ink);
    color: var(--on-ink);
  }
  .btn-ink:hover {
    background: color-mix(in oklab, var(--ink), var(--tape) 16%);
  }
  .btn-rule {
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--rule-strong);
    background: transparent;
  }
  .btn-rule:hover {
    box-shadow: inset 0 0 0 1.5px var(--ink);
    background: var(--tape-2);
  }

  /* Store buttons: the one tint carries every action. */
  .store {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-block-size: 3.5rem;
    padding: 0.55rem 1.25rem 0.55rem 1rem;
    border-radius: var(--radius-control);
    background: var(--tint);
    color: var(--on-tint);
    text-decoration: none;
    transition:
      background-color 140ms var(--ease-out),
      scale 140ms var(--ease-out);
  }
  .store:hover {
    background: var(--tint-pressed);
  }
  .store:active {
    scale: 0.985;
  }
  .store svg {
    inline-size: 1.4rem;
    flex: none;
  }
  .store span {
    display: grid;
    line-height: 1.1;
  }
  .store small {
    font-size: 0.75rem;
    opacity: 0.85;
  }
  .store b {
    font-family: var(--font-label);
    font-stretch: 100%;
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  [dir='rtl'] .store {
    padding: 0.55rem 1rem 0.55rem 1.25rem;
  }
  [dir='rtl'] .store b {
    direction: ltr;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  /* A band of label tape, stitched just inside both long edges. */
  .tape-band {
    position: relative;
    background: var(--tape);
  }
  .tape-band::before {
    content: '';
    position: absolute;
    inset: 7px 0;
    border-block: 1px dashed var(--rule-strong);
    pointer-events: none;
  }

  /* ---------- nav ---------- */
  .nav {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    background: var(--tape);
    border-block-end: 1px dashed var(--rule-strong);
  }
  .nav-inner {
    max-inline-size: var(--max);
    margin-inline: auto;
    padding: 0.6rem var(--gutter);
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
    min-block-size: 2.75rem;
  }
  .brand-word {
    font-family: var(--font-label);
    font-stretch: 118%;
    font-weight: 800;
    font-size: 1.125rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  :root[lang='ar'] .brand-word {
    font-weight: 700;
    font-size: 1.25rem;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
  }
  .nav-links a,
  .lang {
    font-family: var(--font-label);
    font-stretch: 84%;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-stamp);
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 0.75rem;
  }
  :root[lang='ar'] .nav-links a {
    font-size: 0.9375rem;
  }
  .nav-links a:hover,
  .lang:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .lang:lang(ar) {
    font-family: 'Noto Kufi Arabic Variable', sans-serif;
    font-size: 0.9375rem;
    text-transform: none;
    letter-spacing: 0;
  }
  .nav-end {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  @media (max-width: 63.99rem) {
    .nav-links {
      display: none;
    }
  }

  /* ---------- hero ---------- */
  .hero {
    max-inline-size: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: minmax(14rem, 1fr) auto 4.5rem;
    column-gap: 1.5rem;
    min-block-size: calc(100svh - 3.9rem);
    padding-block: 1.5rem 3rem;
  }
  .hero-photo {
    grid-column: 1 / 10;
    grid-row: 1 / 3;
    margin-inline-start: calc(-1 * var(--gutter));
    min-block-size: 16rem;
    overflow: hidden;
    background: var(--tape-3);
  }
  .hero-photo img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 78%;
  }
  .hero-tape {
    grid-column: 1 / 8;
    grid-row: 2 / 4;
    align-self: end;
    margin-block-start: -5rem;
    padding: 2.25rem 2.5rem 2rem;
    display: grid;
    gap: 1rem;
    box-shadow: 0 1px 2px rgb(22 24 28 / 0.06), 0 18px 40px -22px rgb(22 24 28 / 0.35);
  }
  .hero-fibre {
    font-size: 0.8125rem;
    text-transform: uppercase;
  }
  :root[lang='ar'] .hero-fibre {
    text-transform: none;
  }
  .hero-lead {
    font-size: 1.125rem;
    color: var(--ink-2);
    max-inline-size: 46ch;
  }
  .hero-tape .cta-row {
    margin-block-start: 0.5rem;
  }
  .hero-phone {
    grid-column: 9 / 13;
    grid-row: 1 / 4;
    align-self: center;
    justify-self: center;
    margin: 0;
    position: relative;
    z-index: 2;
    inline-size: min(100%, 22rem, calc((100svh - 9rem) * 0.462));
    display: grid;
    gap: 0.9rem;
    justify-items: center;
  }
  .hero-phone .phone {
    rotate: -2deg;
  }
  .hero-phone figcaption {
    background: var(--tape);
    padding: 0.2rem 0.6rem;
  }
  [dir='rtl'] .hero-phone .phone {
    rotate: 2deg;
  }

  @media (max-width: 63.99rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      min-block-size: 0;
      padding-block: 0 2rem;
    }
    .hero-photo {
      grid-column: 1;
      grid-row: 1;
      margin-inline: calc(-1 * var(--gutter));
      aspect-ratio: 4 / 3;
      max-block-size: 52svh;
      inline-size: auto;
    }
    .hero-tape {
      grid-column: 1;
      grid-row: 2;
      margin-block-start: -3.5rem;
      padding: 1.75rem 1.25rem 1.5rem;
    }
    .hero-phone {
      grid-column: 1;
      grid-row: 3;
      margin: 2.5rem 0 0;
      inline-size: min(76vw, 19rem);
    }
  }

  /* ---------- demo ---------- */
  .demo {
    max-inline-size: var(--max);
    margin-inline: auto;
    padding: clamp(4rem, 8vw, 8rem) var(--gutter) 2rem;
    border-block-start: 1px solid var(--rule);
  }
  .demo-title {
    max-inline-size: 16ch;
  }
  .demo-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
  }
  .steps {
    grid-column: 1 / 7;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step {
    min-block-size: 92svh;
    display: grid;
    align-content: center;
    padding-block: 3rem;
  }
  .step-track {
    min-block-size: 150svh;
    align-content: start;
    padding-block-start: 30svh;
  }
  .step-track .step-text {
    position: sticky;
    inset-block-start: 22svh;
  }
  .step-text {
    display: grid;
    gap: 0.9rem;
    max-inline-size: 30rem;
  }
  .step-glyph {
    color: var(--tint);
    margin-block-end: 0.4rem;
  }
  .step h3 {
    font-family: var(--font-label);
    font-stretch: 104%;
    font-weight: 700;
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.25rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  :root[lang='ar'] .step h3 {
    letter-spacing: 0;
    line-height: 1.4;
  }
  .step p {
    color: var(--ink-2);
    font-size: 1.125rem;
    max-inline-size: 40ch;
  }
  .js .step {
    opacity: 0.38;
    transition: opacity 420ms var(--ease-out);
  }
  .js .step[data-current] {
    opacity: 1;
  }

  .stage-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    border-block-start: 1px solid var(--rule);
  }
  .stage-list li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-block: 0.7rem;
    border-block-end: 1px solid var(--rule);
    color: var(--ink-3);
    font-weight: 500;
    transition: color 260ms var(--ease-out);
  }
  .stage-list li[data-state='done'] {
    color: var(--ink-2);
  }
  .stage-list li[data-state='active'] {
    color: var(--ink);
    font-weight: 700;
  }
  .stage-list-glyph {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    flex: none;
  }
  .stage-list-glyph .g-filled,
  .stage-list-glyph .g-done {
    opacity: 0;
  }
  .stage-list-glyph .g-outline,
  .stage-list-glyph .g-filled,
  .stage-list-glyph .g-done {
    transition: opacity 260ms var(--ease-out);
  }
  [data-state='active'] > .stage-list-glyph .g-outline,
  [data-state='done'] > .stage-list-glyph .g-outline {
    opacity: 0;
  }
  [data-state='active'] > .stage-list-glyph .g-filled,
  [data-state='done'] > .stage-list-glyph .g-done {
    opacity: 1;
  }

  .demo-stage {
    grid-column: 8 / 12;
    position: sticky;
    inset-block-start: 5rem;
    block-size: calc(100svh - 6rem);
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.9rem;
  }
  .demo-stage .phone {
    inline-size: min(100%, 21rem, calc((100svh - 10rem) * 0.462));
  }
  .step-phone {
    display: none;
  }

  @media (max-width: 63.99rem) {
    .demo-stage {
      display: none;
    }
    .steps {
      grid-column: 1 / -1;
    }
    .step,
    .step-track,
    .js .step {
      min-block-size: 0;
      opacity: 1;
      padding-block: 3rem 1rem;
      gap: 2rem;
    }
    .step-track .step-text {
      position: static;
    }
    .step-phone {
      display: block;
      justify-self: center;
      inline-size: min(76vw, 19rem);
    }
  }

  /* ---------- two ways ---------- */
  .ways,
  .clean,
  .levels,
  .faq {
    max-inline-size: var(--max);
    margin-inline: auto;
    padding: clamp(4.5rem, 9vw, 9rem) var(--gutter) 0;
  }
  .ways-labels {
    margin-block-start: 3rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--tape-2);
    border-block: 1px dashed var(--rule-strong);
    outline: 7px solid var(--tape-2);
    position: relative;
  }
  /* The seam the two labels are sewn along. */
  .ways-labels::after {
    content: '';
    position: absolute;
    inset-block: 1.25rem;
    inset-inline-start: 50%;
    border-inline-start: 1px dashed var(--rule-strong);
  }
  .way {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 3rem);
  }
  .way-head {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .way-head h3 {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .way-head .stamp {
    color: var(--tint);
    margin-block-start: 0.2rem;
  }
  .way-body {
    color: var(--ink-2);
    max-inline-size: 46ch;
  }
  .ticket {
    background: var(--tape);
    padding: 1.5rem 1.5rem 1.25rem;
    border-radius: var(--radius-slot);
    box-shadow: 0 1px 2px rgb(22 24 28 / 0.06), 0 10px 26px -16px rgb(22 24 28 / 0.3);
    display: grid;
    gap: 0.9rem;
    max-inline-size: 28rem;
  }
  .ticket table {
    border-collapse: collapse;
    inline-size: 100%;
    font-variant-numeric: tabular-nums;
  }
  .ticket th,
  .ticket td {
    padding-block: 0.45rem;
    font-weight: 400;
    border-block-end: 1px dotted var(--rule-strong);
  }
  .ticket th {
    text-align: start;
  }
  .ticket td {
    text-align: end;
    font-weight: 600;
  }
  .ticket tr.sub th,
  .ticket tr.sub td {
    border-block-start: 1px solid var(--ink);
    font-weight: 600;
  }
  .qty-x {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .ticket-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .serial-amount {
    font-family: var(--font-label);
    font-stretch: 118%;
    font-weight: 800;
    font-size: 2.5rem;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    direction: ltr;
  }
  .serial-amount small {
    font-size: 0.45em;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
  .woven-tag,
  .woven-label {
    position: relative;
    justify-self: start;
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-slot);
    background: var(--ink);
    color: var(--on-ink);
    font-family: var(--font-label);
    font-stretch: 84%;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-stamp);
    font-size: 0.75rem;
    line-height: 1.25;
  }
  .woven-tag::after,
  .woven-label::after {
    content: '';
    position: absolute;
    inset: 2.5px;
    border: 0.9px dashed color-mix(in oklab, currentColor 50%, transparent);
    border-radius: 2px;
  }
  .woven-tag b,
  .woven-label b {
    font-weight: 800;
  }
  .wizard {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--rule);
    counter-reset: w;
  }
  .wizard li {
    counter-increment: w;
    padding: 0.85rem 0.5rem 0.85rem 0;
    font-size: 0.9375rem;
    font-weight: 600;
    display: grid;
    gap: 0.15rem;
  }
  .wizard li::before {
    content: counter(w);
    font-family: var(--font-label);
    font-stretch: 118%;
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--ink-3);
  }
  [dir='rtl'] .wizard li {
    padding: 0.85rem 0 0.85rem 0.5rem;
  }
  .reserved {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    max-inline-size: 28rem;
  }
  .reserved-slot {
    flex: 1;
    max-inline-size: 16rem;
    padding: 0.85rem 1rem;
    background: var(--tape-3);
    border-radius: var(--radius-slot);
    text-align: center;
    color: var(--ink-2);
    font-weight: 600;
    outline: 1px dashed var(--rule-strong);
    outline-offset: -5px;
  }
  .report {
    display: flex;
    gap: 0.75rem;
    align-items: start;
    max-inline-size: 46ch;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--rule);
    font-size: 0.9375rem;
  }
  .report svg {
    flex: none;
    margin-block-start: 0.1rem;
  }
  @media (max-width: 47.99rem) {
    .ways-labels {
      grid-template-columns: minmax(0, 1fr);
    }
    .ways-labels::after {
      inset-inline: 1.25rem;
      inset-block: 50% auto;
      border-inline-start: 0;
      border-block-start: 1px dashed var(--rule-strong);
    }
    .wizard {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- what we clean ---------- */
  .rail {
    list-style: none;
    padding: 0;
    margin: 3.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: 3rem;
    position: relative;
    border-block-start: 2px dashed var(--rule-strong);
  }
  .piece {
    position: relative;
    display: grid;
    align-content: start;
  }
  .thread {
    justify-self: center;
    inline-size: 1px;
    block-size: var(--hang, 1.5rem);
    background: var(--rule-strong);
  }
  .piece-photo {
    overflow: hidden;
    background: var(--tape-3);
    aspect-ratio: 4 / 5;
  }
  .piece-photo img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: scale 900ms var(--ease-out);
  }
  .piece:hover .piece-photo img {
    scale: 1.03;
  }
  .piece-0 {
    grid-column: 1 / 5;
    --hang: 1.5rem;
  }
  .piece-1 {
    grid-column: 5 / 9;
    --hang: 5rem;
  }
  .piece-1 .piece-photo {
    aspect-ratio: 1;
  }
  .piece-2 {
    grid-column: 9 / 13;
    --hang: 2.75rem;
  }
  .piece-3 {
    grid-column: 1 / -1;
    --hang: 0rem;
  }
  .piece-3 .thread {
    display: none;
  }
  .piece-3 .piece-photo {
    aspect-ratio: 1200 / 353;
  }
  /* The sewn label: light cloth, as a real sewn-in label would be. */
  .sewn {
    position: relative;
    justify-self: start;
    margin: -1.75rem 0 0 1rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0.8rem 1.1rem 0.8rem 0.9rem;
    background: #fbfbf9;
    color: #16181c;
    border-radius: var(--radius-slot);
    box-shadow: 0 1px 2px rgb(22 24 28 / 0.1), 0 8px 20px -12px rgb(22 24 28 / 0.35);
    max-inline-size: calc(100% - 2rem);
  }
  [dir='rtl'] .sewn {
    margin: -1.75rem 1rem 0 0;
  }
  .sewn::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px dashed rgb(22 24 28 / 0.28);
    border-radius: 2px;
    pointer-events: none;
  }
  .sewn span {
    display: grid;
    gap: 0.1rem;
  }
  .sewn b {
    font-family: var(--font-label);
    font-stretch: 84%;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--track-stamp);
    font-size: 0.875rem;
  }
  .sewn small {
    font-size: 0.8125rem;
    color: #5e6068;
  }
  :root[lang='ar'] .sewn b {
    font-size: 1rem;
  }
  @media (max-width: 47.99rem) {
    .piece-0,
    .piece-1,
    .piece-2 {
      grid-column: 1 / -1;
    }
    .piece-0 .piece-photo,
    .piece-1 .piece-photo,
    .piece-2 .piece-photo {
      aspect-ratio: 16 / 11;
    }
    .piece-3 .piece-photo {
      aspect-ratio: 16 / 9;
    }
  }

  /* ---------- levels ---------- */
  .levels-band {
    margin-block-start: 3rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    background: var(--tape-2);
    border-block: 1px dashed var(--rule-strong);
    outline: 7px solid var(--tape-2);
  }
  .level {
    padding: clamp(1.5rem, 3vw, 2.75rem);
    display: grid;
    align-content: start;
    gap: 1.1rem;
  }
  .level + .level {
    border-inline-start: 1px solid var(--rule);
  }
  .level-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .level-head h3 {
    font-family: var(--font-label);
    font-stretch: 104%;
    font-weight: 800;
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }
  .level-head .woven-label {
    font-size: 1rem;
    padding: 0.4rem 0.9rem;
  }
  .twin {
    block-size: 4px;
    border-block: 1px solid var(--ink);
  }
  .level ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .level li {
    padding-block: 0.7rem;
    border-block-end: 1px solid var(--rule);
  }
  .level-pay h3 {
    color: var(--ink-2);
    padding-block: 0.6rem;
  }
  .level-pay dl {
    margin: 0;
  }
  .level-pay div {
    padding-block: 0.7rem;
    border-block-end: 1px solid var(--rule);
  }
  .level-pay dt {
    font-weight: 600;
  }
  .level-pay dd {
    margin: 0.1rem 0 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  @media (max-width: 63.99rem) {
    .levels-band {
      grid-template-columns: minmax(0, 1fr);
    }
    .level + .level {
      border-inline-start: 0;
      border-block-start: 1px solid var(--rule);
    }
  }

  /* ---------- faq ---------- */
  .faq {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    padding-block-end: clamp(4.5rem, 9vw, 9rem);
  }
  .faq .section-title {
    grid-column: 1 / 5;
    align-self: start;
    position: sticky;
    inset-block-start: 6rem;
  }
  .faq-list {
    grid-column: 6 / 13;
    border-block-start: 1px solid var(--ink);
  }
  details {
    border-block-end: 1px solid var(--rule);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.3rem;
    cursor: pointer;
    list-style: none;
    font-size: 1.1875rem;
    font-weight: 600;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    inline-size: 1.25rem;
    flex: none;
    color: var(--tint);
    transition: rotate 260ms var(--ease-out);
  }
  details[open] summary svg {
    rotate: 45deg;
  }
  summary:hover span {
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
  }
  details p {
    padding-block-end: 1.4rem;
    color: var(--ink-2);
    max-inline-size: 62ch;
  }
  @media (max-width: 63.99rem) {
    .faq .section-title,
    .faq-list {
      grid-column: 1 / -1;
      position: static;
    }
    .faq-list {
      margin-block-start: 2rem;
    }
  }

  /* ---------- close: the ink field ---------- */
  .close {
    background: var(--field);
    color: var(--on-field);
  }
  .close-inner {
    max-inline-size: var(--max);
    margin-inline: auto;
    padding: clamp(4.5rem, 9vw, 8rem) var(--gutter);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: 3rem;
    position: relative;
  }
  .close-inner::before {
    content: '';
    position: absolute;
    inset: 10px var(--gutter);
    border-block: 1px dashed color-mix(in oklab, var(--on-field) 30%, transparent);
    pointer-events: none;
  }
  .close-main {
    grid-column: 1 / 8;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .close-mark {
    margin-block-end: 0.5rem;
  }
  .close-title {
    font-size: clamp(3rem, 1.4rem + 6vw, 7rem);
  }
  .close-lead {
    font-size: 1.25rem;
    color: var(--on-field-2);
  }
  .store-light {
    background: var(--on-field);
    color: var(--field);
  }
  .store-light:hover {
    background: color-mix(in oklab, var(--on-field), var(--field) 12%);
  }
  .waitlist {
    grid-column: 8 / 13;
    align-self: end;
    display: grid;
    gap: 0.75rem;
  }
  .waitlist h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-block-end: 0.5rem;
  }
  .waitlist label {
    font-size: 0.875rem;
    color: var(--on-field-2);
  }
  .waitlist-row {
    display: flex;
    gap: 0.5rem;
  }
  .waitlist input {
    flex: 1;
    min-inline-size: 0;
    min-block-size: 3.25rem;
    padding: 0.75rem 1rem;
    border: 1.5px solid color-mix(in oklab, var(--on-field) 35%, transparent);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--on-field);
    font: inherit;
    caret-color: var(--field-focus);
  }
  [dir='rtl'] .waitlist input {
    text-align: right;
  }
  .waitlist input::placeholder {
    color: color-mix(in oklab, var(--on-field) 55%, transparent);
  }
  .waitlist input:focus-visible {
    outline: 2px solid var(--field-focus);
    outline-offset: 2px;
    border-color: transparent;
  }
  .waitlist input[aria-invalid='true'] {
    border-color: var(--signal);
  }
  .btn-join {
    background: var(--on-field);
    color: var(--field);
  }
  .btn-join:hover {
    background: color-mix(in oklab, var(--on-field), var(--field) 12%);
  }
  .btn-join:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .close :focus-visible {
